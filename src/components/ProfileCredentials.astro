---
import type { Locale } from '../data/content';
import { content } from '../data/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const es = locale === 'es';
---
<div class="profile-credentials">
  <article class="credential-card education-card" aria-labelledby="education-title" data-reveal>
    <div class="credential-heading"><h3 id="education-title">{c.labels.education}</h3><span class="credential-date">2021-2024</span></div>
    <div class="education-content"><span class="university-mark"><img src="/education/utn.png" alt="UTN" width="4415" height="854" loading="lazy"/></span><div><p class="credential-degree">{c.labels.degree}</p><p class="credential-institution">{es ? 'Universidad Tecnológica Nacional' : 'National Technological University'}</p></div></div>
  </article>
  <article class="credential-card languages-card" aria-labelledby="languages-title" data-reveal>
    <div class="credential-heading"><h3 id="languages-title">{c.labels.languages}</h3><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5h12M9 3v2M5 5c0 6 6 9 8 10M13 5c0 6-6 9-8 10M13 21l4-10 4 10M14.5 17h5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <dl class="credential-languages">{c.languages.map((language, index) => <div><dt>{language.name}</dt><dd><span class="language-level">{index === 0 ? c.labels.native : 'B1'}</span>{index === 1 && <span class="language-level-caption">{es ? 'Intermedio' : 'Intermediate'}</span>}</dd></div>)}</dl>
  </article>
</div>
