---
import type { Locale } from '../data/content';
import { content } from '../data/content';
import CertificateStack, { type Sheet } from './CertificateStack';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const es = locale === 'es';
const institution = es ? 'Universidad Tecnológica Nacional (UTN)' : 'National Technological University (UTN)';
const years = '2021-2024';
// The pile shows the same facts as the list; add certifications here as they come.
const sheets: Sheet[] = [
  { kind: 'degree', title: c.labels.degree, detail: institution, note: years },
  ...c.languages.map(language => ({ kind: 'language' as const, title: language.name, detail: language.level, note: es ? 'Idioma' : 'Language' })),
];
---
<section class="credentials page-shell" id="education" aria-labelledby="credentials-title">
  <div class="credentials-copy">
    <h2 id="credentials-title" class="credentials-title" data-reveal>{es ? 'Formación e idiomas' : 'Education and languages'}</h2>
    <dl class="credentials-list">
      <div>
        <dt>{c.labels.education}</dt>
        <dd><p class="credentials-degree">{c.labels.degree}</p><p class="credentials-institution">{institution} · {years}</p></dd>
      </div>
      <div>
        <dt>{c.labels.languages}</dt>
        <dd><ul class="credentials-languages">{c.languages.map(language => <li><strong>{language.name}</strong> <span>{language.level}</span></li>)}</ul></dd>
      </div>
    </dl>
  </div>
  <CertificateStack client:visible sheets={sheets}/>
</section>
