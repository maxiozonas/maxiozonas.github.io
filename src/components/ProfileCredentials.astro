---
import type { Locale } from '../data/content';
import { content } from '../data/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const es = locale === 'es';
const scale = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
// Spanish is a first language, so its bar is full and carries no CEFR ticks; English sits at B1.
const reached = scale.indexOf('B1');
---
<section class="credentials page-shell" id="education" aria-labelledby="credentials-title">
  <h2 id="credentials-title" class="sr-only">{es ? 'Formación e idiomas' : 'Education and languages'}</h2>
  <dl class="credentials-sheet" data-reveal>
    <div class="credentials-row">
      <dt>{c.labels.education}</dt>
      <dd class="credentials-education">
        <span class="university-mark"><img src="/education/utn.png" alt="UTN" width="4415" height="854" loading="lazy"/></span>
        <div class="credentials-degree-block">
          <p class="credentials-degree">{c.labels.degree}</p>
          <p class="credentials-institution">{es ? 'Universidad Tecnológica Nacional' : 'National Technological University'}</p>
        </div>
        <span class="credentials-date">2021 — 2024</span>
      </dd>
    </div>
    <div class="credentials-row">
      <dt>{c.labels.languages}</dt>
      <dd class="lang-list">
        {c.languages.map((language, index) => <div class="lang-row">
          <div class="lang-top"><span class="lang-name">{language.name}</span><span class="lang-level">{index === 0 ? c.labels.native : c.labels.intermediate}</span></div>
          <div class="lang-scale" role="img" aria-label={index === 0 ? c.labels.native : c.labels.intermediate}>
            {scale.map((_, step) => <i data-on={index === 0 || step <= reached ? 'true' : 'false'} style={`--i:${step}`}></i>)}
          </div>
          {index !== 0 && <div class="lang-ticks" aria-hidden="true">{scale.map((level, step) => <span data-current={step === reached ? 'true' : 'false'}>{level}</span>)}</div>}
        </div>)}
      </dd>
    </div>
  </dl>
</section>
