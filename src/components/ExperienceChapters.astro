---
import { content, profile, type Locale } from '../data/content';
import ExperienceBadges from './ExperienceBadges';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
// Client work shown under the role it belongs to.
const related = { xenova: c.projects.filter(project => project.affiliation === 'Xenova').map(({ name, slug }) => ({ name, slug })) };
// Named in the Gili role text; shown as plain labels because they are not public work.
const integrations = { gili: ['Flexxus', 'Magento'] };
---
<section class="experience-section" id="experience" aria-labelledby="experience-title">
  <div class="experience-heading page-shell">
    <h2 id="experience-title" class="section-title" data-reveal>{c.experienceTitle}</h2>
    <p>{c.experienceIntro}</p>
    <a class="text-link" href={`/cv-maximo-ozonas-${locale}.pdf`} target="_blank" rel="noopener noreferrer">{c.actions.download}</a>
  </div>
  <ExperienceBadges client:visible locale={locale} jobs={c.jobs} holder={profile.name} related={related} integrations={integrations}/>
</section>
