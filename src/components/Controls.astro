---
import type { Locale } from "../data/content";
import { content } from "../data/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const other: Locale = locale === "es" ? "en" : "es";
const ui = content[locale];
---

<div class="header-controls">
  <a
    class="language-toggle"
    href={`/${other}/`}
    data-other={other}
    aria-label={`${ui.nav.language}: ${other.toUpperCase()}`}
    hreflang={other}
  >
    <span class:list={{ "language-active": locale === "es" }}>ES</span>
    <span class="language-divider" aria-hidden="true">/</span>
    <span class:list={{ "language-active": locale === "en" }}>EN</span>
  </a>
  <button
    class="theme-toggle"
    id="theme-toggle"
    type="button"
    aria-label={ui.nav.theme}
    aria-pressed="false"
  >
    <span class="theme-label">{locale === "es" ? "Tema" : "Theme"}</span>
    <span class="theme-value" data-theme-value>{locale === "es" ? "Oscuro" : "Dark"}</span>
  </button>
</div>

<script>
  const themeButton = document.getElementById("theme-toggle");
  const themeValue = document.querySelector<HTMLElement>("[data-theme-value]");
  const root = document.documentElement;

  function updateThemeControl() {
    const light = root.getAttribute("data-theme") === "light";
    themeButton?.setAttribute("aria-pressed", String(light));
    if (themeValue) {
      themeValue.textContent = root.lang === "es" ? (light ? "Claro" : "Oscuro") : (light ? "Light" : "Dark");
    }
  }

  updateThemeControl();
  themeButton?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
    root.setAttribute("data-theme", next);
    updateThemeControl();
    try {
      localStorage.setItem("theme", next);
    } catch {
      // The visual theme still changes when storage is unavailable.
    }
  });

  const languageLink = document.querySelector<HTMLAnchorElement>(".language-toggle");
  languageLink?.addEventListener("click", () => {
    try {
      localStorage.setItem("lang", languageLink.dataset.other || "en");
    } catch {
      // The locale link still navigates when storage is unavailable.
    }
  });
</script>
