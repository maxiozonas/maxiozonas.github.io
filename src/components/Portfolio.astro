---
import type { Locale } from "../data/content";
import { content, profile } from "../data/content";
import Controls from "./Controls.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];
const cvPath = `/cv-maximo-ozonas-${locale}.pdf`;
const [firstName, lastName] = profile.name.split(" ");
const initialProject = c.projects[0]!;
const secondaryProject = c.projects[1]!;
const carouselData = JSON.stringify(c.projects).replace(/</g, "\\u003c");
---

<a class="skip-link" href="#main-content">{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a>

<header class="site-header">
  <a class="brand-capsule" href={`/${locale}/`} aria-label={profile.name}>
    <span class="brand-monogram" aria-hidden="true">MO</span>
    <span class="brand-name">{profile.name}</span>
  </a>
  <details class="nav-capsule" open>
    <summary>{locale === "es" ? "Menú" : "Menu"}</summary>
    <div class="nav-capsule-content">
      <nav class="site-nav" aria-label={locale === "es" ? "Navegación principal" : "Main navigation"}>
        <a href="#experience">{c.nav.experience}</a>
        <a href="#projects">{c.nav.projects}</a>
        <a href="#contact">{c.nav.contact}</a>
      </nav>
      <Controls locale={locale} />
    </div>
  </details>
</header>
<script is:inline>
  if (window.matchMedia("(max-width: 760px)").matches) {
    document.querySelector(".nav-capsule")?.removeAttribute("open");
  }
</script>

<main id="main-content">
  <section class="hero page-shell" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-name">
        <span>{firstName}</span>
        <span>{lastName}<span class="accent-dot" aria-hidden="true">.</span></span>
      </h1>
      <p class="hero-role">{c.heroRole}</p>
      <p class="hero-intro">{c.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#experience">{c.actions.experience}<span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={cvPath} download>
          {c.actions.download}<span class="action-mark" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="project-carousel" data-project-carousel role="region" aria-roledescription="carousel" aria-label={c.carouselLabel} tabindex="0">
      <div class="project-stage" aria-hidden="true">
        <div class="project-sheet project-sheet-back">
          <img
            src={secondaryProject.image}
            alt=""
            width="1440"
            height="1080"
            data-project-back-image
          />
        </div>
        <a class="project-frame project-frame-front" href={initialProject.url} target="_blank" rel="noreferrer" tabindex="-1" data-project-front-link>
          <img
            src={initialProject.image}
            alt=""
            width="1440"
            height="1080"
            fetchpriority="high"
            data-project-front-image
          />
        </a>
      </div>
      <div class="carousel-footer">
        <div class="carousel-caption" aria-live="polite" aria-atomic="true">
          <a class="carousel-project-name" href={initialProject.url} target="_blank" rel="noreferrer" data-project-name>{initialProject.name}</a>
          <p data-project-type>{initialProject.type}</p>
        </div>
        <div class="carousel-controls">
          <button type="button" class="carousel-button" data-project-prev aria-label={c.carouselPrevious}>←</button>
          <span class="carousel-count"><span data-project-current>01</span><span aria-hidden="true"> / {String(c.projects.length).padStart(2, "0")}</span></span>
          <button type="button" class="carousel-button" data-project-next aria-label={c.carouselNext}>→</button>
        </div>
      </div>
    </div>
    <script type="application/json" data-project-data set:html={carouselData} is:inline></script>
  </section>

  <section class="featured-experience page-shell" aria-label={c.labels.featuredExperience}>
    <div class="featured-heading">
      <p class="section-kicker">{c.labels.featuredExperience}</p>
      <span>{c.labels.ongoing}</span>
    </div>
    <div class="featured-grid">
      {c.jobs.map((job, index) => (
        <a class="featured-item" href={`#experience-${index === 0 ? "gili" : "food-partners"}`}>
          <span class="featured-main">
            <span class="featured-name">{job.company}</span>
            <span class="featured-summary">{job.summary}</span>
          </span>
          <span class="featured-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="experience-section page-shell" id="experience" aria-labelledby="experience-title">
    <div class="experience-intro">
      <p class="section-kicker">{c.nav.experience}</p>
      <h2 id="experience-title" class="experience-sticky">{c.experienceTitle}</h2>
      <p class="section-lede">{c.experienceIntro}</p>
      <a class="text-link" href="#projects">{c.experienceLink}<span aria-hidden="true">↘</span></a>
    </div>

    <div class="experience-list">
      {c.jobs.map((job, index) => (
        <article class="experience-card" id={`experience-${index === 0 ? "gili" : "food-partners"}`} data-experience-card>
          <div class="experience-meta">
            <p class="section-kicker">{job.role}</p>
            <p class="experience-period">{job.period}</p>
          </div>
          <div class="company-heading">
            <div>
              <h3>{job.company}</h3>
              <p class="experience-summary">{job.summary}</p>
            </div>
            <span class="status-label">{c.labels.ongoing}</span>
          </div>
          <p class="experience-description">{job.description}</p>

          {job.flow && (
            <ol class="process-flow" aria-label={locale === "es" ? "Etapas del proceso productivo" : "Production process stages"}>
              {job.flow.map((step) => <li>{step}</li>)}
            </ol>
          )}

          <ul class="outcome-list">
            {job.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>

          <div class="technology-row">
            <span class="section-kicker">{c.labels.technologies}</span>
            <ul class="technology-list">
              {job.capabilities.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="projects-section page-shell" id="projects" aria-labelledby="projects-title">
    <div class="projects-heading">
      <div>
        <p class="section-kicker">{c.labels.selectedWork}</p>
        <h2 id="projects-title">{c.projectsTitle}</h2>
      </div>
      <p class="section-lede">{c.projectsIntro}</p>
    </div>
    <div class="projects-grid">
      {c.projects.map((project) => (
        <article class="project-card">
          <img
            class="project-card-image"
            src={project.image}
            alt={project.imageAlt}
            width="1440"
            height="1080"
            loading="lazy"
            decoding="async"
          />
          <div class="project-card-content">
            <h3>{project.name}</h3>
            <p class="project-description">{project.description}</p>
            <p class="project-stack-text"><span>{c.labels.technologies}</span>{project.stack.join(" · ")}</p>
            <div class="project-card-actions">
              <details class="project-details">
                <summary>{c.actions.details}</summary>
                <div class="project-detail-content">
                  <p>{locale === "es" ? "Alcance del trabajo" : "Project scope"}</p>
                  <ul>{project.details.map((detail) => <li>{detail}</li>)}</ul>
                </div>
              </details>
              <a class="project-visit" href={project.url} target="_blank" rel="noreferrer">
                {c.actions.visit}<span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-section page-shell" id="contact" aria-labelledby="contact-title">
    <div class="contact-primary">
      <p class="section-kicker">{c.nav.contact}</p>
      <h2 id="contact-title">
        <span>{c.contactTitle[0]}</span>
        <span class="accent-text">{c.contactTitle[1]}</span>
      </h2>
      <p class="contact-intro">{c.contactIntro}</p>
      <a class="button button-primary contact-button" href={`mailto:${profile.email}`}>
        {c.actions.email}<span class="action-mark" aria-hidden="true">↗</span>
      </a>
      <div class="social-links">
        <a href={profile.github} target="_blank" rel="noreferrer">{c.actions.github}<span aria-hidden="true">↗</span></a>
        <a href={profile.linkedin} target="_blank" rel="noreferrer">{c.actions.linkedin}<span aria-hidden="true">↗</span></a>
      </div>
      <p class="location-note">{c.labels.location}</p>
    </div>

    <div class="contact-details">
      <div class="detail-group">
        <h3>{c.labels.skills}</h3>
        <div class="skills-grid">
          {c.skills.map((group) => (
            <div class="skill-group">
              <h4>{group.title}</h4>
              <p>{group.items.join(" · ")}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="credentials-grid">
        <div class="detail-group">
          <h3>{c.labels.education}</h3>
          <p class="credential-copy">{c.degree}</p>
        </div>
        <div class="detail-group">
          <h3>{c.labels.languages}</h3>
          <ul class="language-list">
            {c.languages.map((language) => <li><span>{language.name}</span><span>{language.level}</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer page-shell">
  <div>
    <a class="footer-name" href="#top">{profile.name}</a>
    <p>{c.eyebrow}</p>
  </div>
  <div class="footer-downloads">
    <span>{c.actions.downloadLabel}</span>
    <a href="/cv-maximo-ozonas-es.pdf" download>Español <span aria-hidden="true">↓</span></a>
    <a href="/cv-maximo-ozonas-en.pdf" download>English <span aria-hidden="true">↓</span></a>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  interface CarouselProject {
    name: string;
    url: string;
    image: string;
    imageAlt: string;
    type: string;
  }

  gsap.registerPlugin(ScrollTrigger);

  const navCapsule = document.querySelector<HTMLDetailsElement>(".nav-capsule");
  navCapsule?.addEventListener("click", (event) => {
    if (!window.matchMedia("(max-width: 760px)").matches || !(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('.site-nav a[href^="#"]');
    if (!link) return;
    const destination = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (!destination) return;

    requestAnimationFrame(() => {
      navCapsule.open = false;
      if (!destination.hasAttribute("tabindex")) destination.setAttribute("tabindex", "-1");
      destination.focus({ preventScroll: true });
    });
  });

  const carousel = document.querySelector<HTMLElement>("[data-project-carousel]");
  const projectData = document.querySelector<HTMLScriptElement>("[data-project-data]");
  const projects: CarouselProject[] = projectData?.textContent ? JSON.parse(projectData.textContent) : [];
  const previousButton = carousel?.querySelector<HTMLButtonElement>("[data-project-prev]");
  const nextButton = carousel?.querySelector<HTMLButtonElement>("[data-project-next]");
  const currentCount = carousel?.querySelector<HTMLElement>("[data-project-current]");
  const frontImage = carousel?.querySelector<HTMLImageElement>("[data-project-front-image]");
  const backImage = carousel?.querySelector<HTMLImageElement>("[data-project-back-image]");
  const frontLink = carousel?.querySelector<HTMLAnchorElement>("[data-project-front-link]");
  const captionLink = carousel?.querySelector<HTMLAnchorElement>("[data-project-name]");
  const captionType = carousel?.querySelector<HTMLElement>("[data-project-type]");
  let activeProject = 0;

  function renderProject(index: number) {
    if (!projects.length || !frontImage || !backImage || !frontLink || !captionLink || !captionType || !currentCount) return;
    activeProject = (index + projects.length) % projects.length;
    const active = projects[activeProject]!;
    const secondary = projects[(activeProject + 1) % projects.length]!;
    frontImage.src = active.image;
    frontImage.alt = active.imageAlt;
    frontLink.href = active.url;
    captionLink.href = active.url;
    captionLink.textContent = active.name;
    captionType.textContent = active.type;
    backImage.src = secondary.image;
    backImage.alt = "";
    currentCount.textContent = String(activeProject + 1).padStart(2, "0");
  }

  function changeProject(direction: number) {
    if (!projects.length) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const frame = carousel?.querySelector<HTMLElement>(".project-frame-front");
    if (reduceMotion || !frame) {
      renderProject(activeProject + direction);
      return;
    }
    gsap.to(frame, {
      rotateY: direction > 0 ? -10 : 10,
      duration: 0.14,
      ease: "power1.in",
      onComplete: () => {
        renderProject(activeProject + direction);
        gsap.fromTo(frame, { rotateY: direction > 0 ? 8 : -8 }, { rotateY: 0, duration: 0.32, ease: "power2.out" });
      },
    });
  }

  previousButton?.addEventListener("click", () => changeProject(-1));
  nextButton?.addEventListener("click", () => changeProject(1));
  carousel?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") {
      event.preventDefault();
      changeProject(-1);
    } else if (event.key === "ArrowRight") {
      event.preventDefault();
      changeProject(1);
    }
  });

  const scrollMotion = gsap.matchMedia();
  scrollMotion.add("(min-width: 960px) and (min-height: 720px) and (prefers-reduced-motion: no-preference)", () => {
    const pinnedHeading = document.querySelector<HTMLElement>(".experience-sticky");
    const experience = document.querySelector<HTMLElement>("#experience");
    if (pinnedHeading && experience) {
      ScrollTrigger.create({
        trigger: experience,
        start: "top top+=104",
        end: "bottom bottom",
        pin: pinnedHeading,
        pinSpacing: false,
        invalidateOnRefresh: true,
      });
    }

    const cards = gsap.utils.toArray<HTMLElement>("[data-experience-card]");
    cards.slice(0, -1).forEach((card) => {
      gsap.to(card, {
        scale: 0.985,
        transformOrigin: "top center",
        ease: "none",
        scrollTrigger: {
          trigger: card,
          start: "top top+=120",
          end: "bottom top+=120",
          scrub: true,
        },
      });
    });
  });
</script>
