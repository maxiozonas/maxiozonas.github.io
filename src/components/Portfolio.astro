---
import type { Locale } from '../data/content';
import { content, profile } from '../data/content';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Motion from './Motion.astro';
import HeroTitle from './HeroTitle';
import HeroActions from './HeroActions';
import ProfileCredentials from './ProfileCredentials.astro';
import TechIcon from './TechIcon.astro';
import SkillsFolders from './SkillsFolders';
import WorkMap from './WorkMap';
import { getTechnologyUsage } from '../data/technology-usage';
import MagicBento from './reactbits/MagicBento';
import ScrollStack from './reactbits/ScrollStack';
import SpotlightCard from './reactbits/SpotlightCard';
import { buttonVariants } from './ui/button';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const es = locale === 'es';
---
<Header locale={locale}/>
<main id="main-content" class="w-full max-w-full overflow-x-clip">
  <section class="hero page-shell" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-role" data-hero-enter>{es ? 'Desarrollo de software' : 'Software development'}</p>
      <HeroTitle client:load/>
      <p class="hero-profession" data-hero-enter>Full Stack Developer</p>
      <p class="hero-intro" data-hero-enter>{es ? 'Aplicaciones web y móviles. Integraciones entre sistemas. De la idea a producción.' : 'Web and mobile apps. System integrations. From idea to production.'}</p>
      <div class="hero-actions-wrap" data-hero-enter><HeroActions client:load locale={locale}/></div>
      <div class="hero-location" data-hero-enter><span>Bahía Blanca, Argentina</span><span>{es ? 'Trabajo remoto' : 'Remote work'}</span></div>
    </div>
  </section>
  <section class="experience-section page-shell grid gap-12 py-24 lg:grid-cols-[.75fr_1.25fr] lg:gap-20 lg:py-32" id="experience" aria-labelledby="experience-title">
    <div class="experience-intro self-start"><p class="section-eyebrow">{es ? 'Experiencia' : 'Experience'}</p><h2 id="experience-title" class="section-title">{es ? 'Dentro de' : 'Inside'}<br/><span class="text-muted-foreground">{es ? 'la operación.' : 'the operation.'}</span></h2><p class="mt-7 max-w-sm text-base leading-relaxed text-muted-foreground">{c.experienceIntro}</p><a class="text-link mt-8 inline-flex min-h-11 items-center font-bold" href={`/cv-maximo-ozonas-${locale}.pdf`} download>{c.actions.download}</a><div class="experience-key"><span class="status-dot"></span>{es ? 'Dos equipos. Problemas reales.' : 'Two teams. Real problems.'}</div></div>
    <ScrollStack client:visible>{c.jobs.map((job, index) => <article class="experience-card scroll-stack-card" id={`experience-${index === 0 ? 'gili' : 'food-partners'}`}>
      <SpotlightCard client:visible className="experience-spotlight" spotlightColor="#dcff71" intensity={.12} borderGlow={.25} proximity={30} flare={false}>
        <div class="experience-meta"><span>{job.period}</span><span class="job-current"><span class="status-dot"></span>{es ? 'Actualidad' : 'Current'}</span></div>
        <div class="job-heading"><span class:list={['company-logo', { 'company-logo-gili': index === 0 }]}><img src={`/companies/${index === 0 ? 'gili' : 'food-partners'}.png`} alt={job.company} width={index === 0 ? 160 : 334} height={index === 0 ? 79 : 72}/></span><h3>{job.role}</h3></div>
        <p class="job-summary">{job.summary}</p><p class="job-description">{job.description}</p>
        <dl class="job-scope">{job.scope.map(area => <div><dt>{area.title}</dt><dd>{area.description}</dd></div>)}</dl>
        <ul class="job-stack" aria-label={c.labels.technologies}>{job.capabilities.map(skill => <li><TechIcon name={skill}/></li>)}</ul>
      </SpotlightCard>
    </article>)}</ScrollStack>
  </section>
  <section id="projects" class="projects-section page-shell pb-20 pt-10 md:pb-32 md:pt-16" aria-labelledby="projects-title">
    <p class="section-eyebrow">{es ? 'Trabajo seleccionado' : 'Selected work'}</p>
    <div class="mb-10 flex flex-col justify-between gap-5 md:mb-14 md:flex-row md:items-end"><h2 id="projects-title" class="section-title" data-reveal>{es ? 'Ideas que ya' : 'Ideas already'}<br/><span class="text-muted-foreground">{es ? 'están afuera.' : 'out in the world.'}</span></h2><p class="max-w-xs text-base leading-relaxed text-muted-foreground">{es ? 'Turismo, ingeniería y salud animal. Cada proyecto, un problema distinto.' : 'Travel, engineering and pet healthcare. Each project, a different problem.'}</p></div>
    <MagicBento client:visible projects={c.projects} locale={locale}/>
  </section>
  <section class="profile-section page-shell py-24 md:py-32" id="skills" aria-labelledby="profile-title">
    <p class="section-eyebrow">{es ? 'Cómo trabajo' : 'How I work'}</p>
    <div class="profile-composition">
      <div class="profile-copy">
        <h2 id="profile-title" class="profile-heading">{es ? 'Buen software empieza por entender.' : 'Good software starts with understanding.'}</h2>
        <p class="profile-support">{es ? 'Conecto desarrollo, arquitectura y gestión. Entender cómo trabaja un equipo es parte de construir una solución que le sirva.' : 'I connect development, architecture and delivery. Understanding how a team works is part of building a useful solution.'}</p>
        <p class="profile-map-hint">{es ? 'Explorá cada parte del mapa. El proceso vuelve al equipo, porque el trabajo no termina con el despliegue.' : 'Explore each part of the map. The process comes back to the team, because the work continues beyond deployment.'}</p>
      </div>
      <WorkMap client:visible locale={locale}/>
    </div>
    <div class="toolbox-section" id="toolbox" aria-labelledby="toolbox-title">
      <div class="toolbox-heading"><div><p class="section-eyebrow">{c.labels.technologies}</p><h2 id="toolbox-title">{es ? 'Mi caja de herramientas.' : 'My toolbox.'}</h2></div><p>{es ? 'Abrí una carpeta y explorá las tecnologías que uso. Cada una tiene su lugar y su trabajo detrás.' : 'Open a folder and explore the technologies I use. Each one has its place and the work behind it.'}</p></div>
      <SkillsFolders client:visible locale={locale} groups={c.skills} usage={getTechnologyUsage(locale)}/>
    </div>
    <ProfileCredentials locale={locale}/>
  </section>
  <section class="contact-section page-shell py-24 md:py-32" id="contact" aria-labelledby="contact-title">
    <div class="contact-panel rounded-3xl bg-primary p-7 text-primary-foreground md:p-16"><p class="mb-8 text-sm">{es ? '¿Tenés una idea en mente?' : 'Have something in mind?'}</p><h2 id="contact-title" class="contact-title font-bold tracking-tighter" data-reveal>{es ? 'Hagamos que' : 'Let’s make'}<br/>{es ? 'funcione.' : 'it work.'}</h2><div class="mt-10 flex flex-col justify-between gap-8 md:flex-row md:items-end"><a class="contact-email text-lg font-bold md:text-2xl" href={`mailto:${profile.email}`}>{profile.email}</a><a class={buttonVariants({ variant: 'inverse', size: 'lg' })} href={`mailto:${profile.email}`}>{c.actions.email}</a></div></div>
    <div class="mt-8 flex flex-wrap justify-between gap-6 text-sm"><p class="text-muted-foreground">{es ? 'Bahía Blanca, Argentina. Abierto a trabajar en remoto.' : 'Bahía Blanca, Argentina. Open to remote work.'}</p><div class="flex gap-3"><a class="social-button" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a class="social-button" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></div></div>
  </section>
</main>
<Footer locale={locale}/>
<Motion/>
