---
import "../styles/global.css";
import type { Locale } from "../data/content";
import { content, profile } from "../data/content";

interface Props {
  locale: Locale;
  title?: string;
}

const { locale, title } = Astro.props;
const otherLocale = locale === "es" ? "en" : "es";
const pageTitle = title ?? `${profile.name} | ${profile.role[locale]}`;
const description = content[locale].intro;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={`https://maxiozonas.github.io/${locale}/`} />
    <link rel="alternate" hreflang={locale} href={`https://maxiozonas.github.io/${locale}/`} />
    <link rel="alternate" hreflang={otherLocale} href={`https://maxiozonas.github.io/${otherLocale}/`} />
    <link rel="alternate" hreflang="x-default" href="https://maxiozonas.github.io/" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://maxiozonas.github.io/${locale}/`} />
    <meta name="twitter:card" content="summary" />

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='18'%20fill='%2307090d'/%3E%3Ctext%20x='32'%20y='42'%20text-anchor='middle'%20font-family='Arial,sans-serif'%20font-size='24'%20font-weight='700'%20fill='%23dcff71'%3EMO%3C/text%3E%3C/svg%3E"
    />

    <link rel="preload" href="/fonts/cabinet-grotesk-regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
