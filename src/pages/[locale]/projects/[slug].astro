---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProjectImage from '../../../components/ProjectImage.astro';
import TechIcon from '../../../components/TechIcon.astro';
import Motion from '../../../components/Motion.astro';
import { content } from '../../../data/content';
import { caseStudies } from '../../../data/case-studies';
import type { Locale, Project } from '../../../data/content';
export function getStaticPaths() {
  return (['es', 'en'] as Locale[]).flatMap(locale => content[locale].projects.map((project, index, projects) => ({
    params: { locale, slug: project.slug },
    props: { locale, project, next: projects[(index + 1) % projects.length] },
  })));
}
interface Props { locale: Locale; project: Project; next: Project; }
const { locale, project, next } = Astro.props;
const es = locale === 'es';
const c = content[locale];
const study = caseStudies[locale][project.slug]!;
---
<Base locale={locale} title={`${project.name} | Máximo Ozonas`} description={project.summary} image={project.image}>
  <Header locale={locale} detail/>
  <main id="main-content" class="project-detail-page page-shell">
    <a class="back-link" href={`/${locale}/#projects`}>{es ? 'Todos los proyectos' : 'All projects'}</a>
    <div class="detail-heading">
      <div><p class="project-type">{es ? 'Caso de proyecto' : 'Project case study'} / {project.type}</p><h1 style={`view-transition-name: title-${project.slug}`}>{project.name}</h1><p class="detail-summary">{project.summary}</p><a class="button button-primary" href={project.url} target="_blank" rel="noopener noreferrer">{c.actions.visit}</a></div>
      <dl class="detail-facts"><div><dt>{es ? 'Entregables' : 'Deliverables'}</dt><dd>{study.deliverable}</dd></div><div><dt>{es ? 'Enfoque' : 'Focus'}</dt><dd>{study.focus}</dd></div><div><dt>Stack</dt><dd><ul class="detail-stack">{project.stack.map(technology => <li><TechIcon name={technology}/></li>)}</ul></dd></div></dl>
    </div>
    <div class="detail-image"><ProjectImage project={project} priority shared large/></div>
    <nav class="case-navigation" aria-label={es ? 'Secciones del proyecto' : 'Project sections'}><a href="#scope-title">{es ? 'Contexto' : 'Context'}</a><a href="#features-title">{es ? 'Funcionalidades' : 'Features'}</a><a href="#architecture-title">{es ? 'Arquitectura' : 'Architecture'}</a><a href="#decisions-title">{es ? 'Decisiones' : 'Decisions'}</a></nav>
    <section class="case-context" aria-labelledby="scope-title"><div><p class="section-eyebrow">{es ? 'El problema' : 'The problem'}</p><h2 id="scope-title" class="case-title">{es ? 'Alcance del trabajo' : 'Project scope'}</h2></div><div class="detail-deliverables"><p>{study.context}</p><p>{project.description}</p></div></section>
    <section class="case-section" aria-labelledby="features-title"><p class="section-eyebrow">{es ? 'El producto' : 'The product'}</p><h2 id="features-title" class="case-title">{es ? 'Qué permite hacer.' : 'What it makes possible.'}</h2><div class="case-features">{study.features.map((feature) => <article data-reveal><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div></section>
    <section class="case-section" aria-labelledby="architecture-title"><p class="section-eyebrow">{es ? 'El sistema' : 'The system'}</p><h2 id="architecture-title" class="case-title">{es ? 'Cómo se conecta.' : 'How it connects.'}</h2><div class="case-architecture">{study.architecture.map((layer) => <article><h3>{layer.name}</h3><p>{layer.description}</p><ul>{layer.technologies.map(technology => <li><TechIcon name={technology}/></li>)}</ul></article>)}</div></section>
    <section class="case-section case-decisions" aria-labelledby="decisions-title"><div><p class="section-eyebrow">{es ? 'Criterio técnico' : 'Technical approach'}</p><h2 id="decisions-title" class="case-title">{es ? 'Decisiones que importan.' : 'Decisions that matter.'}</h2></div><div>{study.decisions.map(decision => <article data-reveal><h3>{decision.title}</h3><p>{decision.text}</p></article>)}</div></section>
    <section class="case-result" aria-labelledby="result-title"><p class="section-eyebrow">{es ? 'Resultado y alcance' : 'Outcome and scope'}</p><h2 id="result-title" class="case-title">{es ? 'Lo que queda construido.' : 'What has been built.'}</h2><p>{study.result}</p></section>
    <a class="next-project" href={`/${locale}/projects/${next.slug}/`} aria-labelledby="next-project-kicker next-project-title next-project-action">
      <div class="next-project-copy">
        <p class="next-project-kicker" id="next-project-kicker">{es ? 'Siguiente proyecto' : 'Next project'}</p>
        <h2 id="next-project-title" style={`view-transition-name: title-${next.slug}`}>{next.name}</h2>
        <p class="next-project-summary">{next.summary}</p>
        <span class="next-project-label" id="next-project-action">{es ? 'Ver caso completo' : 'View full case study'}</span>
      </div>
      <div class="next-project-preview"><ProjectImage project={next} shared/></div>
    </a>
  </main>
  <Footer locale={locale}/>
  <Motion/>
</Base>
